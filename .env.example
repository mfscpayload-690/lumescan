# ==========================================
# LumeScan Environment Configuration Template
# ==========================================

# ------------------------------------------
# SECTION 1: Backend Server (.env in server/)
# ------------------------------------------

# GitHub API Authentication (Recommended to avoid rate limits when fetching repo trees)
GITHUB_TOKEN=your_github_token_here

# Groq API Configuration (Primary LPU-speed analysis engine)
GROQ_API_KEY=your_groq_api_key_here

# Bytéz API Configuration (Fallback engine for rate-limits/large files)
BYTEZ_API_KEY=your_bytez_api_key_here
FALLBACK_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# CORS Configuration (Origins permitted to make API calls)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ------------------------------------------
# SECTION 2: Frontend Dashboard (.env.local in web/)
# ------------------------------------------

# Local API Base URL targeting the FastAPI server endpoint
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
